#!/usr/bin/env bash
# run-codex-qa — hand one exact commit to the remote QA VM, wait for the job, and bring its
# verdict and evidence back into the run folder. Codex is a remote job, not a subagent:
# this script is the only interface between the Claude Code lead and the VM.
#
#   run-codex-qa --run <run-dir> --base <sha> --commit <sha> \
#                (--profile <tilt-profile> | --services "<svc> <svc> ...") [--worker <id>] [--dry-run]
#   run-codex-qa --status  <attempt-dir>     reconnect to an attempt (never redispatches)
#   run-codex-qa --collect <attempt-dir>     download its result when terminal
#   run-codex-qa --cancel  <attempt-dir>     stop it deliberately
#
# --services starts only the named Tilt services (infrastructure is derived by the
# Tiltfile); --profile starts a named profile. Give exactly one.
#
# Run it from the lane worktree whose commit you are sending (its preflight reads the
# working tree it stands in), after writing <run-dir>/qa-charter.md from
# qa/charter.template.md. It prints the absolute attempt directory,
# <run-dir>/qa/<job-id>/attempts/<attempt-id>/, where verdict.json, the VM's manifest,
# the event log and evidence/ land; check them with
#   verdict-check.sh <attempt-dir> <lane-worktree> --remote
#
# Config: <zora-harness>/qa.env (gitignored; ~/.zora-harness/qa.env still read as a
# fallback), a file named by ZORA_QA_CONFIG, or the same variables in the environment
#   ZORA_QA_HOST         ssh destination for the VM (a ~/.ssh/config alias is best)
#   ZORA_QA_REMOTE_HOME  QA home on the VM, e.g. /home/zqa/zora-qa
#   ZORA_QA_WORKERS_FILE JSON inventory of named workers, selected with --worker
#                        (HOST/REMOTE_HOME above act as the default worker)
#   ZORA_QA_REPO         clone URL the VM uses (default: this checkout's origin URL)
#   ZORA_QA_TIMEOUT      seconds to wait for a job (default 10800)
#   ZORA_QA_POLL         seconds between status polls (default 30)
#
# Exit 0  the job finished and its results were downloaded (verdict-check decides pass/fail)
# Exit 1  preflight refused: nothing was sent to the VM
# Exit 2  usage error
# Exit 3  transport or remote failure: VM unreachable, job lost, timed out, or an unsafe result archive
#
# Internal: run-codex-qa --extract <archive.tar.gz> <dest-dir> runs only the safe extractor.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage()  { echo "usage: run-codex-qa --run <run-dir> --base <sha> --commit <sha> (--profile <tilt-profile> | --services \"<svc> ...\") [--worker <id>] [--dry-run]" >&2; exit 2; }
refuse() { echo "REFUSED    $*" >&2; exit 1; }
failed() { echo "FAILED     $*" >&2; exit 3; }

# Only regular files, only allowed names and types, size-capped, nothing escaping the
# destination. Any violation rejects the whole archive and extracts nothing: a result that
# tries to smuggle a link or a stray path is not trusted in part.
safe_extract() {
  python3 - "$1" "$2" <<'PY'
import os, sys, tarfile
src, dest = sys.argv[1], sys.argv[2]
ALLOWED_TOP = {"verdict.json", "remote-manifest.json", "codex-events.jsonl"}
ALLOWED_EXT = {".txt", ".log", ".json", ".jsonl", ".md", ".png", ".jpg", ".jpeg", ".webm", ".zip", ".html", ".cjs", ".patch", ".diff"}
MAX_FILE, MAX_TOTAL, MAX_FILES = 25 << 20, 400 << 20, 2000
problems, plan, total = [], [], 0
try:
    tf = tarfile.open(src, "r:gz")
except (OSError, tarfile.TarError) as e:
    print(f"REJECTED   not a readable gzip tar archive: {e}", file=sys.stderr)
    sys.exit(1)
with tf:
    for m in tf.getmembers():
        name = m.name
        norm = os.path.normpath(name)
        if os.path.isabs(name) or norm == ".." or norm.startswith("../"):
            problems.append(f"path escapes the job folder: {name!r}")
            continue
        if m.isdir():
            continue
        if not m.isfile():
            problems.append(f"not a regular file (link, device or fifo): {name!r}")
            continue
        in_top = norm in ALLOWED_TOP
        in_evidence = norm.startswith("evidence/") and os.path.splitext(norm)[1].lower() in ALLOWED_EXT
        if not (in_top or in_evidence):
            problems.append(f"name or file type not allowed: {name!r}")
            continue
        if m.size > MAX_FILE:
            problems.append(f"file over {MAX_FILE >> 20} MB: {name!r}")
            continue
        total += m.size
        plan.append((m, norm))
    if total > MAX_TOTAL:
        problems.append(f"archive holds {total >> 20} MB, over the {MAX_TOTAL >> 20} MB cap")
    if len(plan) > MAX_FILES:
        problems.append(f"archive holds {len(plan)} files, over the {MAX_FILES} cap")
    if problems:
        for p in problems:
            print(f"REJECTED   {p}", file=sys.stderr)
        sys.exit(1)
    for m, norm in plan:
        target = os.path.join(dest, norm)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with tf.extractfile(m) as fin, open(target, "wb") as fout:
            for chunk in iter(lambda: fin.read(1 << 20), b""):
                fout.write(chunk)
        os.chmod(target, 0o644)
print(f"extracted  {len(plan)} files, {total} bytes")
PY
}

if [ "${1:-}" = "--extract" ]; then
  [ $# -eq 3 ] || usage
  mkdir -p "$3"
  safe_extract "$2" "$3"
  exit 0
fi

if [[ "${1:-}" = --collect || "${1:-}" = --status || "${1:-}" = --cancel ]]; then
  exec python3 "$HERE/qa-dispatch.py" "$@"
fi
RUN="" BASE="" COMMIT="" PROFILE="" SERVICES="" WORKER="" DRY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --run|--base|--commit|--profile|--services|--worker)
      [ $# -ge 2 ] || usage
      case "$1" in --worker) WORKER="$2" ;; --run) RUN="$2" ;; --base) BASE="$2" ;; --commit) COMMIT="$2" ;; --profile) PROFILE="$2" ;; --services) SERVICES="$2" ;; esac
      shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) sed -n '2,35p' "$0"; exit 0 ;;
    *) usage ;;
  esac
done
[ -n "$RUN" ] && [ -n "$BASE" ] && [ -n "$COMMIT" ] && [ -n "$PROFILE$SERVICES" ] || usage
if [ -n "$PROFILE" ] && [ -n "$SERVICES" ]; then echo "choose --profile or --services, not both" >&2; exit 2; fi

HARNESS="$(cd -P "$HERE/../../.." && pwd)"  # the checkout behind the install symlink
CONF="${ZORA_QA_CONFIG:-$HARNESS/qa.env}"
[ -f "$CONF" ] || [ -n "${ZORA_QA_CONFIG:-}" ] || CONF="$HOME/.zora-harness/qa.env"  # former location
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

# ---------------------------------------------------------------- preflight (local only)
RUN="$(cd "$RUN" 2>/dev/null && pwd)" || refuse "run folder does not exist"
TOP="$(git rev-parse --show-toplevel 2>/dev/null)" || refuse "run this from the zora-pantheon checkout"
cd "$TOP"

if [ -n "$PROFILE" ]; then
  [[ "$PROFILE" =~ ^[a-z0-9-]+$ ]] || refuse "profile must be a plain name like 'documents'"
  grep -qE "^[[:space:]]*\"$PROFILE\"[[:space:]]*:" tilt/Tiltfile 2>/dev/null \
    || refuse "unknown Tilt profile '$PROFILE' (see PROFILES in tilt/Tiltfile)"
else
  SERVICES="$(printf '%s' "$SERVICES" | tr ',' ' ' | xargs)"
  [ -n "$SERVICES" ] || refuse "--services is empty"
  for svc in $SERVICES; do
    [[ "$svc" =~ ^[a-z0-9-]+$ ]] || refuse "service names are plain names like 'api-gateway'"
    grep -qF "\"$svc\"" tilt/Tiltfile 2>/dev/null \
      || refuse "unknown Tilt service '$svc' (see SERVICES in tilt/Tiltfile)"
  done
fi

COMMIT_FULL="$(git rev-parse --verify --quiet "${COMMIT}^{commit}")" || refuse "unknown commit: $COMMIT"
BASE_FULL="$(git rev-parse --verify --quiet "${BASE}^{commit}")" || refuse "unknown base commit: $BASE"
HEAD_FULL="$(git rev-parse HEAD)"
[ "$HEAD_FULL" = "$COMMIT_FULL" ] \
  || refuse "HEAD is ${HEAD_FULL:0:12}, not the commit to validate (${COMMIT_FULL:0:12}); check it out first"
[ -z "$(git status --porcelain)" ] \
  || refuse "the working tree has uncommitted changes; commit them first, since the VM only sees pushed commits"
git merge-base --is-ancestor "$BASE_FULL" "$COMMIT_FULL" \
  || refuse "base ${BASE_FULL:0:12} is not an ancestor of ${COMMIT_FULL:0:12}"
git fetch --quiet origin || refuse "git fetch origin failed, so the push cannot be confirmed"
[ -n "$(git branch -r --contains "$COMMIT_FULL" 2>/dev/null)" ] \
  || refuse "commit ${COMMIT_FULL:0:12} is not on any origin branch; push it first (git push -u origin HEAD)"

CHARTER="$RUN/qa-charter.md"
[ -f "$CHARTER" ] || refuse "no charter at $CHARTER (start from qa/charter.template.md)"
python3 - "$CHARTER" "$BASE_FULL" "$COMMIT_FULL" <<'PY' || refuse "the charter is not clean (see above)"
import re, sys
path, base, commit = sys.argv[1:4]
text = re.sub(r"<!--.*?-->", "", open(path, encoding="utf-8").read(), flags=re.S)
problems = []
for heading in ("## Commits", "## Task", "## Acceptance criteria", "## Environment", "## Required rungs"):
    if not re.search(r"^" + re.escape(heading) + r"[ \t]*$", text, flags=re.M | re.I):
        problems.append(f"missing section: {heading}")
if base not in text:
    problems.append(f"the base commit {base[:12]} does not appear in full")
if commit not in text:
    problems.append(f"the feature commit {commit[:12]} does not appear in full")
if "<<FILL" in text:
    problems.append("unfilled <<FILL: ...>> markers remain")
NARRATIVE = ["implementer", "already works", "already fixed", "known limitation",
             "i implemented", "we implemented", "i fixed", "we fixed", "works on my machine"]
for n, line in enumerate(text.splitlines(), 1):
    low = line.lower()
    for phrase in NARRATIVE:
        if phrase in low:
            problems.append(f"line {n} carries narrative ({phrase!r}): {line.strip()[:90]}")
for p in problems:
    print(f"CHARTER    {p}", file=sys.stderr)
sys.exit(1 if problems else 0)
PY

REPO_URL="${ZORA_QA_REPO:-$(git remote get-url origin)}"
[[ "$REPO_URL" != *"'"* ]] || refuse "repository URL contains a quote"
# The immutable expected identity is persisted before any network upload.
export ZORA_QA_HOST ZORA_QA_REMOTE_HOME ZORA_QA_WORKERS_FILE ZORA_QA_TIMEOUT ZORA_QA_POLL
exec python3 "$HERE/qa-dispatch.py" submit --run "$RUN" --base "$BASE_FULL" \
  --commit "$COMMIT_FULL" --profile "$PROFILE" --services "$SERVICES" \
  --repo "$REPO_URL" --worker "$WORKER" --dry "$DRY"
